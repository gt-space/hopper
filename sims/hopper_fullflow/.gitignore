# Full transient history (~220 MB), rewritten by every python Hopper.py run
Hopper_Prop_System.h5

# Per-run archives (the latest results for viewing are copied to Outputs/)
Hopper_Results/

# Monte Carlo per-run results (monte_carlo.keep_files); the CSV summaries and plot are kept
Outputs/MonteCarlo/*.h5

# Scratch files the vent and drain calculators delete after a normal run
Outputs/_vent.h5
Outputs/_drain.h5

# Python bytecode caches
__pycache__/

# Local environments and validation scratch
.venv/
.venv-validation/
venv/
validation_outputs/
