function [Trajectory,unom,tgrid,m_profile,I_profile] = Trajectory3()

clear; close all; clc;

%% Trajectory Parameters
m0 = 114;        % initial mass [kg]
dm = 25;         % mass burnt [kg]
Tmin = 890;      % N
Tmax = 2400;     % N

t_ascend = 5;    % s
t_hover  = 3;    % s
t_descend= 5;    % s
h_hover  = 50;   % m

dt = 0.01;       % time step
tgrid = 0:dt:(t_ascend+t_hover+t_descend);
N = length(tgrid);

%% Mass profile
m = m0 - dm * min(tgrid/(t_ascend),1);  % linear burn during ascent, constant after

%% Z trajectory (minimum jerk)
z = zeros(1,N);
vz = zeros(1,N);

% Minimum jerk coefficients
t1 = t_ascend;
t2 = t_ascend + t_hover;
t3 = t_ascend+t_hover+t_descend;

for i = 1:N
    t = tgrid(i);
    if t <= t1
        tau = t/t1;
        z(i) = h_hover*(10*tau^3 - 15*tau^4 + 6*tau^5);
        vz(i)= h_hover*(30*tau^2 - 60*tau^3 + 30*tau^4)/t1;
    elseif t <= t2
        z(i) = h_hover;
        vz(i)= 0;
    else
        tau = (t-t2)/t_descend;
        z(i) = h_hover*(1 - (10*tau^3 - 15*tau^4 + 6*tau^5));
        vz(i)= -h_hover*(30*tau^2 - 60*tau^3 + 30*tau^4)/t_descend;
    end
end

%% Small lateral motion for linearization
A_lat = 0.01;  % m
f_lat = 0.1;   % rad/s
X = A_lat*sin(f_lat*tgrid);
Y = A_lat*cos(f_lat*tgrid);

%% Small roll/pitch/yaw excitations
A_rot = deg2rad(1);  % small 1 deg excitation
P = A_rot*sin(0.3*tgrid);   % roll rate
Q = A_rot*sin(0.2*tgrid);   % pitch rate
R = A_rot*cos(0.2*tgrid);   % yaw rate

%% Quaternion from small rotation rates (simple integration)
q0 = ones(1,N);
q1 = zeros(1,N);
q2 = zeros(1,N);
q3 = zeros(1,N);

% Integrate quaternion for visualization (small angles approx)
for i = 2:N
    dt_i = tgrid(i)-tgrid(i-1);
    q1(i) = q1(i-1) + 0.5*P(i-1)*dt_i;
    q2(i) = q2(i-1) + 0.5*Q(i-1)*dt_i;
    q3(i) = q3(i-1) + 0.5*R(i-1)*dt_i;
    q0(i) = sqrt(1 - q1(i)^2 - q2(i)^2 - q3(i)^2);  % normalize
end

%% TVC and RCS signals
delta_p = Q;      % pitch TVC aligned with pitch
delta_y = R;      % yaw TVC aligned with yaw
F_rcs   = P;      % RCS aligned with roll

%% Thrust profile (gravity + Z accel)
T = m .* (9.81 + diff([0 vz])./dt);   % approximate
T = max(min(T,Tmax),Tmin);

%% Package trajectory for linearization
Trajectory = [X(:), Y(:), z(:), zeros(N,1), zeros(N,1), vz(:), ...
              P(:), Q(:), R(:), q0(:), q1(:), q2(:), q3(:)];
unom = [T(:), delta_p(:), delta_y(:), F_rcs(:)];

%% ======================== PLOTS ========================

%% ALTITUDE / VELOCITY / THRUST

figure('Name','Vertical Motion')

subplot(3,1,1)
plot(tgrid,-Z,'LineWidth',2)
ylabel('Altitude (m)')
title('Altitude')
grid on
xlim([0 tf])

subplot(3,1,2)
plot(tgrid,Vz,'LineWidth',2)
ylabel('Vertical Velocity (m/s)')
grid on
xlim([0 tf])

subplot(3,1,3)
plot(tgrid,T,'LineWidth',2)
ylabel('Thrust (N)')
xlabel('Time (s)')
grid on
xlim([0 tf])

%% CONTROL INPUTS

figure('Name','Control Inputs')

subplot(3,1,1)
plot(tgrid,rad2deg(delta_p),'LineWidth',2)
ylabel('Pitch TVC (deg)')
grid on
xlim([0 tf])

subplot(3,1,2)
plot(tgrid,rad2deg(delta_y),'LineWidth',2)
ylabel('Yaw TVC (deg)')
grid on
xlim([0 tf])

subplot(3,1,3)
plot(tgrid,F_rcs,'LineWidth',2)
ylabel('RCS Force (N)')
xlabel('Time (s)')
grid on
xlim([0 tf])

%% ATTITUDE

figure('Name','Attitude')

subplot(3,1,1)
plot(tgrid,rad2deg(roll),'LineWidth',2)
ylabel('Roll (deg)')
grid on
xlim([0 tf])

subplot(3,1,2)
plot(tgrid,rad2deg(pitch),'LineWidth',2)
ylabel('Pitch (deg)')
grid on
xlim([0 tf])

subplot(3,1,3)
plot(tgrid,rad2deg(yaw),'LineWidth',2)
ylabel('Yaw (deg)')
xlabel('Time (s)')
grid on
xlim([0 tf])

%% BODY RATES

figure('Name','Body Rates')

plot(tgrid,[P Q R]*180/pi,'LineWidth',2)
xlabel('Time (s)')
ylabel('Rate (deg/s)')
legend('P','Q','R')
grid on
xlim([0 tf])

%% MASS

figure('Name','Mass Profile')

plot(tgrid,m_profile,'LineWidth',2)
xlabel('Time (s)')
ylabel('Mass (kg)')
grid on
xlim([0 tf])

%% 3D TRAJECTORY

figure('Name','3D Trajectory')

plot3(X,Y,-Z,'LineWidth',2)
xlabel('X (m)')
ylabel('Y (m)')
zlabel('Altitude (m)')
title('Rocket Flight Path')
grid on
view(35,25)




