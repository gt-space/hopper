close all; clc;
clear CL; clear X; clear lyapEigs; clear poles;
clear CL_noquat;clear poles_noquat;

Q = ones(13,13);
Q_noquat = ones(9,9);

for i = 1:length(t)-1

  CL(:,:,i) = A(:,:,i) - B(:,:,i)*K1(:,:,i);


  X(:,:,i) = lyap(CL(:,:,i)', Q);
  lyapEigs(:,i) = eig(X(:,:,i));
  poles(:,i)    = eig(CL(:,:,i));
  [V,D]    = eig(CL(:,:,i));

  if any(real(poles(:,i)) >= 0)
      check(i) = 0;
  else
      check(i) = 1;
  end

end

NOTSTABLE = find(check == 0);

